    "joint_1_velocity",
    "joint_2_velocity",
    "joint_3_velocity",
    "joint_4_velocity",
    "joint_5_velocity"
  ],
  "feedback_uses_joint_angles": true,
  "feedback_uses_joint_velocities": true,
